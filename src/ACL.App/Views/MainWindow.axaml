<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ACL.App.ViewModels"
        x:Class="ACL.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="ACL"
        Width="1120" Height="740"
        MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        Background="Transparent">

  <Panel>
    <!-- 背景 -->
    <Border Background="{StaticResource AclBackgroundBrush}" />
    <Ellipse Width="760" Height="760" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-320,-260,0">
      <Ellipse.Fill>
        <RadialGradientBrush>
          <GradientStop Color="#42409BFF" Offset="0" />
          <GradientStop Color="#00409BFF" Offset="1" />
        </RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>
    <Ellipse Width="600" Height="600" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-220,0,0,-240">
      <Ellipse.Fill>
        <RadialGradientBrush>
          <GradientStop Color="#331FC8C0" Offset="0" />
          <GradientStop Color="#001FC8C0" Offset="1" />
        </RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>

    <!-- 常规界面 -->
    <Grid RowDefinitions="60,*,76" IsVisible="{Binding !IsFullscreen}">
      <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" PointerPressed="OnTitleBarPressed">
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="18,0,0,0" VerticalAlignment="Center">
          <Path Data="{StaticResource AclLogoGeometry}" Fill="{StaticResource AclPrimaryBrush}" Width="20" Height="26" Stretch="Uniform" />
          <TextBlock Text="ACL" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource AclTextBrush}" />
          <TextBlock Text="Minecraft 启动器" Classes="AclCaption" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="0,0,14,0" VerticalAlignment="Center">
          <Button Classes="AclWindowButton" Content="⛶" ToolTip.Tip="全屏仪表盘（F11）" Command="{Binding ToggleFullscreenCommand}" />
          <Button Classes="AclWindowButton" Content="–" ToolTip.Tip="最小化" Click="OnMinimize" />
          <Button Classes="AclWindowButton" Content="✕" ToolTip.Tip="关闭" Click="OnClose" />
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" ColumnDefinitions="320,*" Margin="18,0,18,0">
        <StackPanel Spacing="12">
          <Border Classes="AclCard" Padding="18">
            <StackPanel Spacing="6">
              <TextBlock Text="账号" Classes="AclCaption" />
              <TextBlock Text="{Binding State.PlayerName}" Classes="AclTitle" />
              <TextBlock Text="离线登录（微软 / 第三方在 M9 接入界面）" Classes="AclCaption" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Classes="AclCard" Padding="18">
            <StackPanel Spacing="6">
              <TextBlock Text="版本" Classes="AclCaption" />
              <TextBlock Text="{Binding State.SelectedVersionId, TargetNullValue=未选择, FallbackValue=未选择}" Classes="AclTitle" />
              <TextBlock Text="可在“下载”页刷新并安装" Classes="AclCaption" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Classes="AclCard" Padding="18">
            <StackPanel Spacing="6">
              <TextBlock Text="Java" Classes="AclCaption" />
              <TextBlock Text="{Binding State.SelectedJavaHome, TargetNullValue=未探测, FallbackValue=未探测}" Classes="AclTitle" TextWrapping="Wrap" />
              <TextBlock Text="在“设置”页探测本机运行时" Classes="AclCaption" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>

        <ContentControl Grid.Column="1" Margin="16,0,0,0" Content="{Binding CurrentPage}" />
      </Grid>

      <Border Grid.Row="2" Classes="AclSurface" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="8">
        <ItemsControl ItemsSource="{Binding Pages}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:NavItem">
              <Button Classes="AclNav" Classes.selected="{Binding IsSelected}" Content="{Binding Label}" Command="{Binding Select}" CommandParameter="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
    </Grid>

    <!-- 全屏仪表盘 -->
    <Grid RowDefinitions="72,*,Auto" Margin="28,18,28,22" IsVisible="{Binding IsFullscreen}">
      <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Path Data="{StaticResource AclLogoGeometry}" Fill="{StaticResource AclPrimaryBrush}" Width="22" Height="30" Stretch="Uniform" />
          <TextBlock Text="ACL" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource AclTextBrush}" />
        </StackPanel>

        <ItemsControl Grid.Column="1" ItemsSource="{Binding Pages}" HorizontalAlignment="Center" VerticalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:NavItem">
              <Button Classes="AclNav" Classes.selected="{Binding IsSelected}" Content="{Binding Label}" Command="{Binding Select}" CommandParameter="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Grid.Column="2" Classes="AclWindowButton" Content="✕" ToolTip.Tip="退出全屏（Esc）" Command="{Binding ToggleFullscreenCommand}" />
      </Grid>

      <StackPanel Grid.Row="1" Spacing="18" VerticalAlignment="Center">
        <Border Classes="AclCard" Padding="36">
          <StackPanel Spacing="12">
            <TextBlock Text="欢迎回到 ACL" FontSize="30" FontWeight="Bold" Foreground="{StaticResource AclTextBrush}" />
            <TextBlock Text="完全自研的 Minecraft 启动器 · 内核与界面彻底解耦" FontSize="14" Foreground="{StaticResource AclMutedTextBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,10,0,0">
              <Button Classes="AclPrimary" Padding="34,14" FontSize="15" Content="开始游戏" Command="{Binding ShowPageCommand}" CommandParameter="{Binding Pages[0]}" />
              <Button Classes="AclPrimary" Padding="34,14" FontSize="15" Content="安装版本" Command="{Binding ShowPageCommand}" CommandParameter="{Binding Pages[1]}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding Pages}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="4" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:NavItem">
              <Button Classes="AclNav" Padding="0" HorizontalContentAlignment="Stretch" Margin="8" Command="{Binding Select}" CommandParameter="{Binding}">
                <Border Classes="AclCard" Padding="20" MinHeight="140">
                  <StackPanel Spacing="8">
                    <TextBlock Text="{Binding Label}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AclTextBrush}" />
                    <TextBlock Text="{Binding Page.Description}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource AclMutedTextBrush}" />
                  </StackPanel>
                </Border>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <TextBlock Grid.Row="2" Text="按 Esc 退出全屏 · 按 F11 切换" Classes="AclCaption" HorizontalAlignment="Center" />
    </Grid>
  </Panel>

</Window>