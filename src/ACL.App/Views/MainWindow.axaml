<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ACL.App.ViewModels"
        x:Class="ACL.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="ACL"
        Icon="/Assets/logo.ico"
        Width="1140" Height="760"
        MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent">

  <Border x:Name="RootFrame" CornerRadius="14" ClipToBounds="True">
    <Panel>
      <!-- 壁纸背景 + 暗色覆盖 -->
      <Border Background="{DynamicResource AclWallpaperBrush}" />
      <Border Background="#4D060C17" />

      <!-- ======== 常规界面 ======== -->
      <Grid RowDefinitions="54,*,80" IsVisible="{Binding !IsFullscreen}">

        <!-- 顶部栏 -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" PointerPressed="OnTitleBarPressed">
          <StackPanel Orientation="Horizontal" Spacing="10" Margin="18,0,0,0" VerticalAlignment="Center">
            <Image Source="/Assets/logo-256.png" Width="26" Height="26" />
            <TextBlock Text="ACL" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AclTextBrush}" VerticalAlignment="Center" />
            <TextBlock Text="Minecraft 启动器" Classes="AclCaption" VerticalAlignment="Center" />
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="0,0,12,0" VerticalAlignment="Center">
            <Button Classes="AclWindowButton" ToolTip.Tip="全屏仪表盘（F11）" Command="{Binding ToggleFullscreenCommand}">
              <Path Data="{DynamicResource AclIconFullscreen}" Width="15" Height="15" Stretch="Uniform" />
            </Button>
            <Button Classes="AclWindowButton" ToolTip.Tip="最小化" Click="OnMinimize">
              <Path Data="{DynamicResource AclIconMin}" Width="15" Height="15" Stretch="Uniform" />
            </Button>
            <Button Classes="AclWindowButton" ToolTip.Tip="最大化 / 还原" Click="OnToggleMaximize">
              <Path Data="{DynamicResource AclIconRestore}" Width="14" Height="14" Stretch="Uniform" />
            </Button>
            <Button Classes="AclWindowButton danger" ToolTip.Tip="关闭" Click="OnClose">
              <Path Data="{DynamicResource AclIconClose}" Width="15" Height="15" Stretch="Uniform" />
            </Button>
          </StackPanel>
        </Grid>

        <!-- 主体 -->
        <Grid Grid.Row="1" ColumnDefinitions="320,*" Margin="18,0,18,0">
          <StackPanel Spacing="10">
            <Border Classes="AclCard hoverable" Padding="16">
              <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <Border Width="42" Height="42" CornerRadius="999" Background="{DynamicResource AclPrimaryBrush}">
                    <TextBlock Text="{Binding State.AvatarLetter}" Foreground="#FFFFFF" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding State.PlayerName}" Classes="AclSection" />
                    <TextBlock Text="{Binding State.AccountStatus}" Classes="AclCaption" />
                  </StackPanel>
                </StackPanel>
                <TextBox Text="{Binding State.PlayerName}" Watermark="玩家名（离线）" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                  <Button Grid.Column="0" Classes="AclPrimary" Content="离线登录" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Center" Command="{Binding LoginOfflineCommand}" />
                  <Button Grid.Column="1" Classes="AclGhost" Content="微软登录" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Center" Command="{Binding LoginMicrosoftCommand}"
                          IsEnabled="{Binding !State.IsAuthenticating}" />
                </Grid>
                <TextBlock Text="{Binding State.DeviceCodeText}" Classes="AclCaption" TextWrapping="Wrap"
                           IsVisible="{Binding State.DeviceCodeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </Border>

            <Border Classes="AclCard hoverable" Padding="16">
              <StackPanel Spacing="10">
                <TextBlock Text="游戏版本" Classes="AclSection" />
                <ComboBox ItemsSource="{Binding State.Versions}" SelectedItem="{Binding State.SelectedVersion}" HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate DataType="vm:VersionRowViewModel">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Id}" />
                        <TextBlock Grid.Column="1" Text="{Binding TypeLabel}" Classes="AclCaption" Margin="10,0,0,0" />
                      </Grid>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Classes="AclGhost" Content="刷新版本清单" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" Command="{Binding RefreshVersionsCommand}" />
                <TextBlock Text="{Binding VersionStatus}" Classes="AclCaption" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Classes="AclCard hoverable" Padding="16">
              <StackPanel Spacing="6">
                <TextBlock Text="Java" Classes="AclSection" />
                <TextBlock Text="{Binding State.SelectedJavaHome, TargetNullValue=尚未探测, FallbackValue=尚未探测}"
                           Classes="AclCaption" TextWrapping="Wrap" />
                <TextBlock Text="在“设置”页探测本机运行时" Classes="AclCaption" />
              </StackPanel>
            </Border>
          </StackPanel>

          <TransitioningContentControl Grid.Column="1" Margin="14,0,0,0" Content="{Binding CurrentPage}">
            <TransitioningContentControl.PageTransition>
              <CrossFade Duration="0:0:0.18" />
            </TransitioningContentControl.PageTransition>
          </TransitioningContentControl>
        </Grid>

        <!-- 底部导航（左侧页面项 + 右侧主操作） -->
        <Border Grid.Row="2" Classes="AclCard" CornerRadius="999" Margin="16,0,16,12" Padding="6">
          <Grid ColumnDefinitions="*,Auto">
            <ItemsControl Grid.Column="0" ItemsSource="{Binding Pages}" VerticalAlignment="Center" Margin="6,0,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="4" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:NavItem">
                  <Button Classes="AclNav" Classes.selected="{Binding IsSelected}" Command="{Binding Select}" CommandParameter="{Binding}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <Path Data="{Binding Icon}" Width="14" Height="14" Stretch="Uniform" />
                      <TextBlock Text="{Binding Label}" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Grid.Column="1" Classes="AclPrimary" Margin="8,0,0,0" VerticalAlignment="Center" Command="{Binding StartGameCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Path Data="{DynamicResource AclIconPlay}" Width="12" Height="12" Stretch="Uniform" Fill="#FFFFFF" />
                <TextBlock Text="开始游戏" />
              </StackPanel>
            </Button>
          </Grid>
        </Border>
      </Grid>

      <!-- ======== 全屏仪表盘 ======== -->
      <Grid RowDefinitions="76,*,Auto" Margin="30,18,30,20" IsVisible="{Binding IsFullscreen}">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <Image Source="/Assets/logo-256.png" Width="30" Height="30" />
            <TextBlock Text="ACL" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource AclTextBrush}" />
          </StackPanel>

          <ItemsControl Grid.Column="1" ItemsSource="{Binding Pages}" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:NavItem">
                <Button Classes="AclNav" Classes.selected="{Binding IsSelected}" Command="{Binding Select}" CommandParameter="{Binding}">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <Path Data="{Binding Icon}" Width="14" Height="14" Stretch="Uniform" />
                    <TextBlock Text="{Binding Label}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Button Grid.Column="2" Classes="AclWindowButton" ToolTip.Tip="退出全屏（Esc）" Command="{Binding ToggleFullscreenCommand}">
            <Path Data="{DynamicResource AclIconClose}" Width="15" Height="15" Stretch="Uniform" />
          </Button>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="16" VerticalAlignment="Center">
          <Border Classes="AclDarkCard" Padding="34">
            <StackPanel Spacing="12">
              <TextBlock Text="欢迎回到 ACL" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource AclTextBrush}" />
              <TextBlock Text="完全自研的 Minecraft 启动器 · 内核与界面彻底解耦" FontSize="14" Foreground="{DynamicResource AclMutedTextBrush}" />
              <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                <Button Classes="AclPrimary" Padding="34,14" FontSize="15" Content="开始游戏" Command="{Binding StartGameCommand}" />
                <Button Classes="AclGhost" Padding="30,14" FontSize="15" Content="安装版本"
                        Command="{Binding ShowPageCommand}" CommandParameter="{Binding Pages[1]}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <ItemsControl ItemsSource="{Binding Pages}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="5" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:NavItem">
                <Button Classes="AclNav" Padding="0" Margin="6" HorizontalContentAlignment="Stretch"
                        Command="{Binding Select}" CommandParameter="{Binding}">
                  <Border Classes="AclDarkCard hoverable" Padding="20" MinHeight="140">
                    <StackPanel Spacing="8">
                      <TextBlock Text="{Binding Label}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AclTextBrush}" />
                      <TextBlock Text="{Binding Page.Description}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource AclMutedTextBrush}" />
                    </StackPanel>
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="Esc 退出全屏 · F11 切换 · Ctrl+1..5 切换页面"
                   Foreground="{DynamicResource AclMutedTextBrush}" FontSize="12" HorizontalAlignment="Center" />
      </Grid>
    </Panel>
  </Border>

</Window>