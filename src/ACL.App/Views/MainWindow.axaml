<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ACL.App.ViewModels"
        xmlns:anim="using:ACL.App.Animations"
        x:Class="ACL.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="ACL"
        Icon="/Assets/logo.ico"
        Width="1140" Height="760"
        MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        DragDrop.AllowDrop="True">

  <Border x:Name="RootFrame" CornerRadius="14" ClipToBounds="True">
    <Panel PointerPressed="OnWindowPressed">
      <!-- 壁纸背景 + 暗色覆盖 -->
      <Border Background="{DynamicResource AclWallpaperBrush}" />
      <Border Background="{DynamicResource AclOverlayBrush}" />

      <!-- ======== 常规界面 ======== -->
      <Grid RowDefinitions="58,*,Auto,84" IsVisible="{Binding !IsFullscreen}">

        <!-- 顶部栏（整条为拖拽区：透明背景保证命中测试） -->
        <Grid x:Name="TitleBar" Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Background="Transparent"
              PointerPressed="OnTitleBarPressed">
          <StackPanel Orientation="Horizontal" Spacing="10" Margin="18,0,0,0" VerticalAlignment="Center">
            <Image Source="/Assets/logo-256.png" Width="26" Height="26" />
            <TextBlock Text="ACL" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AclTextBrush}" VerticalAlignment="Center" />
            <TextBlock Text="Minecraft 启动器" Classes="AclCaption" VerticalAlignment="Center" />
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="0,0,12,0" VerticalAlignment="Center">
            <Button Classes="AclWindowButton" ToolTip.Tip="全屏仪表盘（F11）" Command="{Binding ToggleFullscreenCommand}">
              <Path Data="{DynamicResource AclIconFullscreen}" Width="15" Height="15" Stretch="Uniform" />
            </Button>
            <Button Classes="AclWindowButton" ToolTip.Tip="最小化" Click="OnMinimize">
              <Path Data="{DynamicResource AclIconMin}" Width="15" Height="15" Stretch="Uniform" />
            </Button>
            <Button Classes="AclWindowButton" ToolTip.Tip="最大化 / 还原" Click="OnToggleMaximize">
              <Path Data="{DynamicResource AclIconRestore}" Width="14" Height="14" Stretch="Uniform" />
            </Button>
            <Button Classes="AclWindowButton danger" ToolTip.Tip="关闭" Click="OnClose">
              <Path Data="{DynamicResource AclIconClose}" Width="15" Height="15" Stretch="Uniform" />
            </Button>
          </StackPanel>
        </Grid>

        <!-- 主体 -->
        <Grid Grid.Row="1" ColumnDefinitions="330,*" Margin="18,0,18,0">
          <ContentControl Grid.Column="0" Content="{Binding CurrentPage.LeftPanel}" />
          <TransitioningContentControl x:Name="PageHost" Grid.Column="1" Margin="14,0,0,0" Content="{Binding CurrentPage}" />
        </Grid>

        <!-- 拖入整合包后的状态 -->
        <Border Grid.Row="2" Classes="AclCard" Margin="16,0,16,8" Padding="14,10"
                IsVisible="{Binding ImportStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock Text="{Binding ImportStatus}" Classes="AclCaption" TextWrapping="Wrap" />
        </Border>

        <!-- 底部导航（左侧页面项 + 右侧主操作） -->
        <Border Grid.Row="3" Classes="AclCard" CornerRadius="999" Margin="16,0,16,12" Padding="6">
          <Grid ColumnDefinitions="*,Auto">
            <ItemsControl Grid.Column="0" ItemsSource="{Binding Pages}" VerticalAlignment="Center" Margin="6,0,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="4" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:NavItem">
                  <Button Classes="AclNav" Classes.selected="{Binding IsSelected}" Command="{Binding Select}" CommandParameter="{Binding}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <Path Data="{Binding Icon}" Width="14" Height="14" Stretch="Uniform" />
                      <TextBlock Text="{Binding Label}" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Grid.Column="1" Classes="AclPrimary" Margin="8,0,0,0" VerticalAlignment="Center" Command="{Binding StartGameCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Path Data="{DynamicResource AclIconPlay}" Width="12" Height="12" Stretch="Uniform" Fill="#FFFFFF" />
                <TextBlock Text="开始游戏" />
              </StackPanel>
            </Button>
          </Grid>
        </Border>
      </Grid>

      <!-- 登录对话框（遮罩 + 卡片，进场动画由代码触发） -->
      <Panel x:Name="DialogOverlay" IsVisible="{Binding IsDialogVisible}">
        <Border x:Name="DialogBackdrop" Classes="AclDialogBackdrop" Background="#99000000" />
        <Border x:Name="DialogCard" Classes="AclCard AclDialogCard" MaxWidth="560" Padding="30"
                HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel Spacing="16">
            <TextBlock Text="{Binding DialogTitle}" Classes="AclHeadline" />
            <TextBlock Text="{Binding DialogMessage}" Classes="AclBody" TextWrapping="Wrap" />
            <Border Classes="AclCard" Padding="20"
                    IsVisible="{Binding DialogCode, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Text="{Binding DialogCode}" FontSize="30" FontWeight="Bold"
                         FontFamily="Cascadia Mono,Consolas,monospace" LetterSpacing="2"
                         HorizontalAlignment="Center" Foreground="{DynamicResource AclSecondaryTextBrush}" />
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
              <Button Classes="AclGhost" Content="打开网页" Command="{Binding OpenVerificationUrlCommand}" />
              <Button Classes="AclGhost" Content="复制代码" Command="{Binding CopyDeviceCodeCommand}" />
              <Button Classes="AclPrimary" Content="取消" Command="{Binding CancelLoginCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Panel>
      <!-- 轻提示（Toast） -->
      <Border Classes="AclCard" CornerRadius="999" Padding="22,11" HorizontalAlignment="Center" VerticalAlignment="Bottom"
              Margin="0,0,0,96"
              IsVisible="{Binding Toast, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Text="{Binding Toast}" Classes="AclBody" />
      </Border>
      <!-- ======== 全屏仪表盘 ======== -->
      <Grid RowDefinitions="76,*,Auto" Margin="30,18,30,20" IsVisible="{Binding IsFullscreen}">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <Image Source="/Assets/logo-256.png" Width="30" Height="30" />
            <TextBlock Text="ACL" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource AclTextBrush}" />
          </StackPanel>

          <ItemsControl Grid.Column="1" ItemsSource="{Binding Pages}" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:NavItem">
                <Button Classes="AclNav" Classes.selected="{Binding IsSelected}" Command="{Binding Select}" CommandParameter="{Binding}">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <Path Data="{Binding Icon}" Width="14" Height="14" Stretch="Uniform" />
                    <TextBlock Text="{Binding Label}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Button Grid.Column="2" Classes="AclWindowButton" ToolTip.Tip="退出全屏（Esc）" Command="{Binding ToggleFullscreenCommand}">
            <Path Data="{DynamicResource AclIconClose}" Width="15" Height="15" Stretch="Uniform" />
          </Button>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="16" VerticalAlignment="Center">
          <Border Classes="AclDarkCard" Padding="34">
            <StackPanel Spacing="12">
              <TextBlock Text="欢迎回到 ACL" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource AclTextBrush}" />
              <TextBlock Text="完全自研的 Minecraft 启动器 · 内核与界面彻底解耦" FontSize="14" Foreground="{DynamicResource AclMutedTextBrush}" />
              <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                <Button Classes="AclPrimary" Padding="34,14" FontSize="15" Content="开始游戏" Command="{Binding StartGameCommand}" />
                <Button Classes="AclGhost" Padding="30,14" FontSize="15" Content="安装版本"
                        Command="{Binding ShowPageCommand}" CommandParameter="{Binding Pages[1]}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <ItemsControl ItemsSource="{Binding Pages}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="5" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:NavItem">
                <Button Classes="AclNav" Padding="0" Margin="6" HorizontalContentAlignment="Stretch"
                        Command="{Binding Select}" CommandParameter="{Binding}">
                  <Border Classes="AclDarkCard hoverable" Padding="20" MinHeight="140">
                    <StackPanel Spacing="8">
                      <TextBlock Text="{Binding Label}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AclTextBrush}" />
                      <TextBlock Text="{Binding Page.Description}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource AclMutedTextBrush}" />
                    </StackPanel>
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="Esc 退出全屏 · F11 切换 · Ctrl+1..5 切换页面"
                   Foreground="{DynamicResource AclMutedTextBrush}" FontSize="12" HorizontalAlignment="Center" />
      </Grid>
    </Panel>
  </Border>

</Window>