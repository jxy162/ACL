<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ACL.App.ViewModels"
             x:Class="ACL.App.App"
             RequestedThemeVariant="Dark">

  <Application.DataTemplates>

    <!-- 启动页 -->
    <DataTemplate DataType="vm:LaunchPageViewModel">
      <ScrollViewer>
        <StackPanel Spacing="12">
          <Border Classes="AclCard" Padding="30">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="{Binding State.VersionTitle}" FontSize="34" FontWeight="Bold"
                           Foreground="{DynamicResource AclTextBrush}" />
                <TextBlock Text="{Binding State.AccountBadge}" Classes="AclCaption" />
              </StackPanel>
              <Button Grid.Column="1" Classes="AclPrimary" Padding="30,13" FontSize="15" VerticalAlignment="Center"
                      Command="{Binding PlanCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Path Data="{DynamicResource AclIconPlay}" Width="13" Height="13" Stretch="Uniform" Fill="#FFFFFF" />
                  <TextBlock Text="开始游戏" />
                </StackPanel>
              </Button>
            </Grid>
          </Border>

          <Border Classes="AclCard" Padding="22">
            <StackPanel Spacing="10">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Classes="AclBadge"><TextBlock Text="{Binding State.VersionBadge}" Classes="AclCaption" /></Border>
                <Border Classes="AclBadge"><TextBlock Text="{Binding State.AccountBadge}" Classes="AclCaption" /></Border>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Classes="AclPrimary" Padding="28,12" FontSize="14" Content="生成启动计划" Command="{Binding PlanCommand}" />
                <Button Classes="AclGhost" Padding="24,12" FontSize="14" Content="安装并启动" Command="{Binding InstallAndLaunchCommand}" />
              </StackPanel>
              <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" Height="6" />
              <TextBlock Text="{Binding Status}" Classes="AclCaption" />
            </StackPanel>
          </Border>

          <Border Classes="AclCard" Padding="24">
            <StackPanel Spacing="10">
              <TextBlock Text="快速上手" Classes="AclSection" />
              <TextBlock Text="1. 在左侧“游戏版本”下拉里选择版本（首次请点“刷新版本清单”）。" Classes="AclBody" TextWrapping="Wrap" />
              <TextBlock Text="2. 点“启动游戏”生成启动计划；点“安装并启动”补齐文件并启动。" Classes="AclBody" TextWrapping="Wrap" />
              <TextBlock Text="3. 下载与设置页可分别管理文件补齐、内存与 Java。" Classes="AclBody" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Classes="AclCard" Padding="22">
            <StackPanel Spacing="8">
              <TextBlock Text="运行环境" Classes="AclSection" />
              <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Java" Classes="AclCaption" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding State.SelectedJavaHome, TargetNullValue=尚未探测（到“设置”页探测）, FallbackValue=尚未探测（到“设置”页探测）}" Classes="AclBody" TextWrapping="Wrap" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="游戏目录" Classes="AclCaption" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GameDirectorySummary}" Classes="AclBody" TextWrapping="Wrap" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="内存" Classes="AclCaption" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MemorySummary}" Classes="AclBody" />
              </Grid>
            </StackPanel>
          </Border>

          <Border Classes="AclCard" Padding="20">
            <StackPanel Spacing="8">
              <TextBlock Text="计划" Classes="AclSection" />
              <TextBlock Text="{Binding PlanSummary}" Classes="AclBody" TextWrapping="Wrap" />
              <TextBlock Text="日志" Classes="AclSection" Margin="0,6,0,0" />
              <ItemsControl ItemsSource="{Binding Log}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" FontSize="12" FontFamily="Cascadia Mono,Consolas,monospace"
                               Foreground="{DynamicResource AclMutedTextBrush}" TextWrapping="Wrap" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>

    <!-- 下载页 -->
    <DataTemplate DataType="vm:DownloadPageViewModel">
      <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <Border Grid.Row="0" Classes="AclCard" Padding="24">
          <StackPanel Spacing="10">
            <TextBlock Text="{Binding Title}" Classes="AclPageTitle" />
            <TextBlock Text="{Binding Description}" Classes="AclCaption" TextWrapping="Wrap" />
            <TextBlock Text="{Binding GameDirectory}" FontSize="12" FontFamily="Cascadia Mono,Consolas,monospace"
                       Foreground="{DynamicResource AclSecondaryTextBrush}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Classes="AclPrimary" Command="{Binding RefreshCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Path Data="{DynamicResource AclIconRefresh}" Width="14" Height="14" Stretch="Uniform" Fill="#FFFFFF" />
                  <TextBlock Text="刷新版本清单" />
                </StackPanel>
              </Button>
              <ComboBox ItemsSource="{Binding KindFilters}" SelectedItem="{Binding KindFilter}" MinWidth="110" />
              <TextBox Text="{Binding Filter}" Watermark="搜索版本（如 1.20）" MinWidth="200" />
            </StackPanel>
            <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" Height="6" />
            <TextBlock Text="{Binding Status}" Classes="AclCaption" />
          </StackPanel>
        </Border>

        <Border Grid.Row="1" Classes="AclCard" Padding="18">
          <TextBlock Text="选择版本后点击右侧“安装”，将把客户端 / 库 / 资源索引补齐到上面的目录。"
                     Classes="AclCaption" TextWrapping="Wrap" />
        </Border>

        <Border Grid.Row="2" Classes="AclCard" Padding="10">
          <ListBox Classes="AclVersionList" ItemsSource="{Binding Filtered}" MaxHeight="360">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:VersionRowViewModel">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                  <Border Grid.Column="0" Classes="AclBadge" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TypeLabel}" Classes="AclCaption" />
                  </Border>
                  <TextBlock Grid.Column="1" Text="{Binding Id}" Classes="AclBody" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding Released}" Classes="AclCaption" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Classes="AclBadge" IsVisible="{Binding IsInstalled}">
                      <TextBlock Text="已安装" Classes="AclCaption" />
                    </Border>
                    <Button Classes="AclGhost" Content="安装" Command="{Binding Install}" CommandParameter="{Binding}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
      </Grid>
    </DataTemplate>

    <!-- 设置页 -->
    <DataTemplate DataType="vm:SettingsPageViewModel">
      <ScrollViewer>
        <StackPanel Spacing="12">
          <Border Classes="AclCard" Padding="24">
            <StackPanel Spacing="6">
              <TextBlock Text="{Binding Title}" Classes="AclPageTitle" />
              <TextBlock Text="{Binding Description}" Classes="AclCaption" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Classes="AclCard" Padding="22">
            <StackPanel Spacing="10">
              <TextBlock Text="外观" Classes="AclSection" />
              <TextBlock Text="{Binding ThemeText}" Classes="AclCaption" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="AclGhost" Content="深色" Command="{Binding UseDarkThemeCommand}" />
                <Button Classes="AclGhost" Content="浅色" Command="{Binding UseLightThemeCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Classes="AclCard" Padding="22">
            <StackPanel Spacing="10">
              <TextBlock Text="启动" Classes="AclSection" />
              <TextBlock Text="最大内存" Classes="AclCaption" />
              <Slider Minimum="512" Maximum="32768" TickFrequency="512" Value="{Binding State.MaxMemoryMb}" />
              <TextBlock Text="{Binding State.MaxMemoryMb, StringFormat='{}{0:F0} MB'}" Classes="AclCaption" />
              <TextBlock Text="最小内存" Classes="AclCaption" Margin="0,4,0,0" />
              <Slider Minimum="256" Maximum="8192" TickFrequency="256" Value="{Binding State.MinMemoryMb}" />
              <TextBlock Text="{Binding State.MinMemoryMb, StringFormat='{}{0:F0} MB'}" Classes="AclCaption" />
              <TextBlock Text="玩家名（离线登录）" Classes="AclCaption" Margin="0,4,0,0" />
              <TextBox Text="{Binding State.PlayerName}" />
            </StackPanel>
          </Border>

          <Border Classes="AclCard" Padding="22">
            <StackPanel Spacing="10">
              <TextBlock Text="网络" Classes="AclSection" />
              <CheckBox Content="优先使用官方源（关闭则镜像优先：BMCLAPI）" IsChecked="{Binding State.PreferOfficial}"
                        Foreground="{DynamicResource AclTextBrush}" />
              <TextBlock Text="下载支持多源回退、断点续传与限速（内核已实现）。" Classes="AclCaption" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Classes="AclCard" Padding="22">
            <StackPanel Spacing="10">
              <TextBlock Text="Java" Classes="AclSection" />
              <Button Classes="AclPrimary" Command="{Binding DetectJavaCommand}" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Path Data="{DynamicResource AclIconJava}" Width="14" Height="14" Stretch="Uniform" Fill="#FFFFFF" />
                  <TextBlock Text="探测本机 Java" />
                </StackPanel>
              </Button>
              <TextBlock Text="{Binding Status}" Classes="AclCaption" />
              <ItemsControl ItemsSource="{Binding JavaRuntimes}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" FontSize="12" FontFamily="Cascadia Mono,Consolas,monospace"
                               Foreground="{DynamicResource AclMutedTextBrush}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>              <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                <Button Classes="AclPrimary" Content="保存设置" Command="{Binding SaveSettingsCommand}" />
              </StackPanel>
              <TextBlock Text="{Binding SettingsStatus}" Classes="AclCaption" TextWrapping="Wrap" />
              <TextBlock Text="{Binding SettingsPath}" FontSize="12" FontFamily="Cascadia Mono,Consolas,monospace"
                         Foreground="{DynamicResource AclSecondaryTextBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Classes="AclCard" Padding="22">
            <StackPanel Spacing="6">
              <TextBlock Text="目录（便携式）" Classes="AclSection" />
              <TextBlock Text="{Binding DataDirectory}" FontSize="12" FontFamily="Cascadia Mono,Consolas,monospace"
                         Foreground="{DynamicResource AclSecondaryTextBrush}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding GameDirectory}" FontSize="12" FontFamily="Cascadia Mono,Consolas,monospace"
                         Foreground="{DynamicResource AclSecondaryTextBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>
    <!-- 更多页 -->
    <DataTemplate DataType="vm:MorePageViewModel">
      <StackPanel Spacing="12">
        <Border Classes="AclCard" Padding="26">
          <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="14">
              <Image Source="/Assets/logo-256.png" Width="56" Height="56" />
              <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{Binding ProductName}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource AclTextBrush}" />
                <TextBlock Text="{Binding AppVersion}" Classes="AclCaption" />
              </StackPanel>
            </StackPanel>
            <TextBlock Text="{Binding KernelNote}" Classes="AclBody" TextWrapping="Wrap" Margin="0,6,0,0" />
            <TextBlock Text="{Binding Notice}" Classes="AclCaption" TextWrapping="Wrap" />
            <Button Classes="AclPrimary" Content="打开游戏目录" Command="{Binding OpenDataDirectoryCommand}"
                    HorizontalAlignment="Left" Margin="0,8,0,0" />
          </StackPanel>
        </Border>
      </StackPanel>
    </DataTemplate>

    <!-- 资源页 -->
    <DataTemplate DataType="vm:ResourcePageViewModel">
      <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <Border Grid.Row="0" Classes="AclCard" Padding="24">
          <StackPanel Spacing="10">
            <TextBlock Text="{Binding Title}" Classes="AclPageTitle" />
            <TextBlock Text="{Binding Description}" Classes="AclCaption" TextWrapping="Wrap" />
            <TextBlock Text="{Binding KeyHint}" Classes="AclCaption" TextWrapping="Wrap"
                       Foreground="{DynamicResource AclSecondaryTextBrush}" />
            <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8" Margin="0,4,0,0">
              <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding Source}" MinWidth="130" />
              <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" MinWidth="110" />
              <ComboBox ItemsSource="{Binding Loaders}" SelectedItem="{Binding Loader}" MinWidth="110" />
              <ComboBox ItemsSource="{Binding Sorts}" SelectedItem="{Binding Sort}" MinWidth="110" />
              <TextBox Text="{Binding GameVersion}" Watermark="游戏版本" MinWidth="120" />
              <TextBox Text="{Binding Query}" Watermark="关键字（如 sodium，回车搜索）" MinWidth="200">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                </TextBox.KeyBindings>
              </TextBox>
              <Button Classes="AclPrimary" Command="{Binding SearchCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Path Data="{DynamicResource AclIconGrid}" Width="14" Height="14" Stretch="Uniform" Fill="#FFFFFF" />
                  <TextBlock Text="搜索" />
                </StackPanel>
              </Button>
            </WrapPanel>
            <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" Height="5" />
            <TextBlock Text="{Binding Status}" Classes="AclCaption" />
          </StackPanel>
        </Border>

        <Border Grid.Row="1" Classes="AclCard" Padding="18">
          <TextBlock Text="安装位置：Mod → mods/　资源包 → resourcepacks/　光影 → shaderpacks/　数据包 → datapacks/（均位于便携游戏目录下）"
                     Classes="AclCaption" TextWrapping="Wrap" />
        </Border>

        <Border Grid.Row="2" Classes="AclCard" Padding="10">
          <ListBox Classes="AclVersionList" ItemsSource="{Binding Results}" MaxHeight="380">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:ResourceRowViewModel">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Title}" Classes="AclBody" FontWeight="SemiBold" />
                      <Border Classes="AclBadge"><TextBlock Text="{Binding Downloads}" Classes="AclCaption" /></Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Author}" Classes="AclCaption" />
                    <TextBlock Text="{Binding Description}" Classes="AclCaption" TextWrapping="Wrap" MaxWidth="620" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                    <Button Classes="AclGhost" Content="安装" Command="{Binding Install}" CommandParameter="{Binding}" />
                    <TextBlock Text="{Binding Status}" Classes="AclCaption" HorizontalAlignment="Center" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
      </Grid>
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://ACL.App/Themes/Dark.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://ACL.App/Styles/Controls.axaml" />
  </Application.Styles>

</Application>