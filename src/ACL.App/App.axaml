<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ACL.App.ViewModels"
             x:Class="ACL.App.App"
             RequestedThemeVariant="Dark">

  <Application.DataTemplates>
    <DataTemplate DataType="vm:PageViewModel">
      <Border Classes="AclCard" Padding="28" VerticalAlignment="Top">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding Title}"
                     FontSize="22"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource AclTextBrush}" />
          <TextBlock Text="{Binding Description}"
                     FontSize="14"
                     TextWrapping="Wrap"
                     Foreground="{StaticResource AclMutedTextBrush}" />
          <TextBlock Text="{Binding Hint}"
                     FontSize="12"
                     Margin="0,6,0,0"
                     TextWrapping="Wrap"
                     Foreground="{StaticResource AclAccentBrush}" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://ACL.App/Styles/Tokens.axaml" />
    <StyleInclude Source="avares://ACL.App/Styles/Controls.axaml" />
  </Application.Styles>

</Application>