  <SolidColorBrush x:Key="AclLaunchBackdropBrush" Color="#F00A111E" />
  <!-- M3 角色令牌（Expressive） -->
  <SolidColorBrush x:Key="AclOnPrimary" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="AclPrimaryContainer" Color="#2A3A63" />
  <SolidColorBrush x:Key="AclOnPrimaryContainer" Color="#DCE4FF" />
  <SolidColorBrush x:Key="AclSecondaryContainer" Color="#1E2A45" />
  <SolidColorBrush x:Key="AclOnSecondaryContainer" Color="#C6D2F0" />
  <SolidColorBrush x:Key="AclSurfaceContainerLow" Color="#99101827" />
  <SolidColorBrush x:Key="AclSurfaceContainerHigh" Color="#B3141F33" />
  <SolidColorBrush x:Key="AclSurfaceContainerHighest" Color="#C7182540" />
  <SolidColorBrush x:Key="AclOutline" Color="#4DFFFFFF" />
