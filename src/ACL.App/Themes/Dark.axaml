  <SolidColorBrush x:Key="AclMutedTextBrush" Color="#A9B6CE" />
  <SolidColorBrush x:Key="AclAccentBrush" Color="#35C6DE" />
  <SolidColorBrush x:Key="AclSecondaryTextBrush" Color="#8FB8FF" />
  <SolidColorBrush x:Key="AclSelectionBrush" Color="#2EFFFFFF" />
  <SolidColorBrush x:Key="AclBadgeBrush" Color="#26FFFFFF" />
  <SolidColorBrush x:Key="AclDangerBrush" Color="#E5484D" />
