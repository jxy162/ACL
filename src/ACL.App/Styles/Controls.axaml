<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="Window">
    <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI, Inter, sans-serif" />
  </Style>

  <Style Selector="Border.AclCard">
    <Setter Property="Background" Value="{StaticResource AclCardBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AclStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="BoxShadow" Value="0 6 20 0 #40000000" />
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Border.AclCard.hoverable:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.012)" />
  </Style>

  <Style Selector="Border.AclDarkCard">
    <Setter Property="Background" Value="{StaticResource AclDarkCardBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AclDarkStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
  </Style>

  <Style Selector="TextBlock.AclPageTitle">
    <Setter Property="Foreground" Value="{StaticResource AclTextBrush}" />
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.AclSection">
    <Setter Property="Foreground" Value="{StaticResource AclTextBrush}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.AclBody">
    <Setter Property="Foreground" Value="{StaticResource AclTextBrush}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="TextBlock.AclCaption">
    <Setter Property="Foreground" Value="{StaticResource AclMutedTextBrush}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="Border.AclBadge">
    <Setter Property="Background" Value="{StaticResource AclBadgeBrush}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="10,3" />
  </Style>

  <!-- 底部导航：选中为浅色胶囊 + 深色文字（参考 LauncherX 的选中态） -->
  <Style Selector="Button.AclNav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource AclMutedTextBrush}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="22,9" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.AclNav /template/ ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.AclNav:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AclSelectionBrush}" />
  </Style>

  <Style Selector="Button.AclNav.selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AclNavSelectedBrush}" />
  </Style>

  <Style Selector="Button.AclNav.selected">
    <Setter Property="Foreground" Value="{StaticResource AclNavSelectedTextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.AclNavDark">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource AclDarkMutedBrush}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="22,9" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.AclNavDark.selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AclNavSelectedBrush}" />
  </Style>

  <Style Selector="Button.AclNavDark.selected">
    <Setter Property="Foreground" Value="{StaticResource AclNavSelectedTextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.AclPrimary">
    <Setter Property="Background" Value="{StaticResource AclPrimaryBrush}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="24,11" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.AclGhost">
    <Setter Property="Background" Value="#1FFFFFFF" />
    <Setter Property="Foreground" Value="{StaticResource AclTextBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AclStrokeStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="20,9" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="Button.AclWindowButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#D8DEEA" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Width" Value="38" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.AclWindowButton:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#33FFFFFF" />
  </Style>

  <Style Selector="Button.AclWindowButton.danger:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#E5484D" />
  </Style>

  <!-- 图标着色 -->
  <Style Selector="Button.AclNav Path, Button.AclNavDark Path, Button.AclWindowButton Path">
    <Setter Property="Fill" Value="{StaticResource AclMutedTextBrush}" />
  </Style>

  <Style Selector="Button.AclNav.selected Path, Button.AclNavDark.selected Path">
    <Setter Property="Fill" Value="{StaticResource AclNavSelectedTextBrush}" />
  </Style>

  <Style Selector="Button.AclWindowButton.danger:pointerover Path">
    <Setter Property="Fill" Value="#FFFFFF" />
  </Style>

  <Style Selector="Button.AclGhost Path">
    <Setter Property="Fill" Value="{StaticResource AclTextBrush}" />
  </Style>

  <!-- 版本/资源列表 -->
  <Style Selector="ListBox.AclVersionList">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="ListBox.AclVersionList ListBoxItem">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="10,8" />
  </Style>

  <Style Selector="ListBox.AclVersionList ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AclSelectionBrush}" />
  </Style>

</Styles>