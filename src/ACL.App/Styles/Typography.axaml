<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- M3 排版尺度（Expressive：大标题更紧、正文更松） -->
  <Style Selector="TextBlock.AclDisplay">
    <Setter Property="FontSize" Value="36" />
    <Setter Property="LineHeight" Value="44" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource AclTextBrush}" />
  </Style>

  <Style Selector="TextBlock.AclHeadline">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="LineHeight" Value="32" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource AclTextBrush}" />
  </Style>

  <Style Selector="TextBlock.AclPageTitle">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="LineHeight" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource AclTextBrush}" />
  </Style>

  <Style Selector="TextBlock.AclSection">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="LineHeight" Value="21" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource AclTextBrush}" />
  </Style>

  <Style Selector="TextBlock.AclBody">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="22" />
    <Setter Property="Foreground" Value="{DynamicResource AclTextBrush}" />
  </Style>

  <Style Selector="TextBlock.AclCaption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="Foreground" Value="{DynamicResource AclMutedTextBrush}" />
  </Style>

</Styles>